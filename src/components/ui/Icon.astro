---
/**
 * Inline SVG icon sprite, colored via `currentColor` so it inherits the
 * text color of its container. Source files are the exact vectors exported
 * from the Figma file (solar:star-outline, basil:university-outline,
 * streamline-flex:crown, iconoir:plus).
 */
import starOutline from '@/assets/icons/courses/star-outline.svg?raw';
import universityOutline from '@/assets/icons/courses/university-outline.svg?raw';
import crown from '@/assets/icons/courses/crown.svg?raw';
import plus from '@/assets/icons/courses/plus.svg?raw';
import minus from '@/assets/icons/courses/minus.svg?raw';

export type IconName = 'star' | 'university' | 'crown' | 'plus' | 'minus' | 'arrow-up-right' | 'menu' | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const arrowUpRight = `<svg viewBox="0 0 17.5 17.5" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M0.75 16.75L16.75 0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M16.75 16.75V0.75H0.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

const menu = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M3 6H21M3 12H21M3 18H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>`;

const close = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M5 5L19 19M19 5L5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>`;

const icons: Record<IconName, string> = {
  star: starOutline,
  university: universityOutline,
  crown,
  plus,
  minus,
  'arrow-up-right': arrowUpRight,
  menu,
  close,
};

const { name, class: className } = Astro.props;
---

<span class:list={['icon', className]} set:html={icons[name]} />

<style>
  .icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
  }

  .icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
