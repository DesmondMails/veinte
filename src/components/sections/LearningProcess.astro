---
import { Image } from 'astro:assets';
import stripesBg from '@/assets/images/learning/stripes-bg.png';
import { learningSteps } from '@/data/learningProcess';
import { getSiteSettings } from '@/lib/content';

const settings = await getSiteSettings();
---

<section class="section learning" aria-labelledby="learning-heading">
  <Image
    src={stripesBg}
    alt=""
    class="learning__bg"
    loading="lazy"
    widths={[640, 1024, 1600, 2305]}
    sizes="100vw"
  />

  <div class="container learning__container">
    <div class="learning__heading-wrap">
      <h2 id="learning-heading" class="learning__title" data-reveal>
        <span class="learning__title-white">Як проходить</span>
        <span class="accent learning__title-accent">навчання?</span>
      </h2>
      <p class="learning__subtitle">
        <span class="learning__subtitle-line">Як відбувається навчання</span>
        <span class="learning__subtitle-line">крок за кроком</span>
      </p>
    </div>

    <ol class="learning__steps">
      {
        learningSteps.map((step, index) => (
          <li class="learning__step" data-reveal data-reveal-index={index}>
            <span class="learning__keycap" aria-hidden="true">
              <span class="learning__keycap-num">{step.number}</span>
            </span>
            <div class="learning__step-text">
              <h3 class="learning__step-title">{step.title}</h3>
              <p class="learning__step-description">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="learning__cta" data-reveal data-reveal-index={learningSteps.length}>
      <a href={settings.ctaPrimary.href} class="btn btn--primary learning__cta-btn">{settings.ctaPrimary.label}</a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../../styles/tokens/breakpoints' as *;
  @use '../../styles/components/button' as btn;

  // Figma 2274:5468 (desktop) / 2274:4408 (mobile).
  $card-bg: #171717;
  $card-border: #2c2e31;

  .learning {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    // Figma: py 80 mobile / 120 desktop (overrides .section rhythm).
    padding-block: var(--space-10);

    @include from('lg') {
      padding-block: var(--space-12);
    }
  }

  .learning__bg {
    // Portrait asset (2305×4096): anchor the grey ribs + orange glow to the
    // section bottom and scale taller than the section so wide viewports don't
    // crop down to the black top band (object-position: top leaves pure black).
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 145%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
    opacity: 0.55;
    mix-blend-mode: screen;

    @include from('xxl') {
      height: 165%;
    }

    @include until('md'){
      height: 115%;
      top: 50%;
    }
  }

  .learning__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-7); // 2.5rem — Figma mobile section gap
    text-align: center;

    @include from('lg') {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 34.875rem; // 558px
      grid-template-rows: auto 1fr;
      column-gap: var(--space-9);
      text-align: left;
    }
  }

  .learning__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); // 16px
    text-align: left;
    list-style: none;
    margin: 0;
    padding: 0;

    @include from('lg') {
      display: grid;
      grid-column: 1;
      grid-row: 1 / 3;
      grid-template-columns: repeat(2, 20.5rem); // 328px cards
      grid-template-areas: 'a .' 'b c';
      align-self: start;
      max-width: 42rem; // 672px = 328 + 16 + 328

      .learning__step:nth-child(1) {
        grid-area: a;
      }

      .learning__step:nth-child(2) {
        grid-area: b;
      }

      .learning__step:nth-child(3) {
        grid-area: c;
      }
    }
  }

  .learning__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5); // 24px — Figma mobile cards 2–3
    padding: var(--space-5);
    border-radius: var(--radius-md); // 8px
    background: $card-bg;
    border: 1px solid $card-border;

    // Figma mobile card 1: p 32 / gap 32.
    &:first-child {
      gap: var(--space-6);
      padding: var(--space-6);
    }

    @include from('lg') {
      gap: var(--space-7); // 40px
      padding: var(--space-7); // 40px
      width: 20.5rem;
    }

    @include until('lg') {
      width: 100%;
    }
  }

  .learning__step-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); // 16px — Figma title → body
    width: 100%;
  }

  .learning__keycap {
    @include btn.keycap-shell(8px);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 4rem; // 64px — Figma 2274:5472
    height: 3.875rem; // 62px

    &::before {
      background-image: url('/images/ui/keycap-shell.png');
      background-size: 100% 100%;
      background-position: center;
    }
  }

  .learning__keycap-num {
    font-family: var(--font-mono);
    font-weight: var(--fw-bold);
    font-size: 1.125rem; // 18px — Figma keycap label
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .learning__step-title {
    margin: 0;
    font-family: var(--font-pixel);
    text-transform: uppercase;
    font-size: 1.5rem; // 24px — Figma H5
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: var(--color-surface-50);
  }

  .learning__step-description {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-caption); // 12px — Figma Body 5
    line-height: 1.4;
    color: var(--color-surface-200);
  }

  .learning__heading-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-5); // 24px — Figma heading → subtitle
    align-items: center;

    @include from('lg') {
      grid-column: 2;
      grid-row: 1;
      align-items: flex-end;
      text-align: right;
    }
  }

  .learning__title {
    display: flex;
    flex-direction: column;
    gap: var(--space-2); // 8px — Figma title lines
    line-height: var(--lh-tight);
    width: 100%;
    max-width: 21.375rem; // 342px mobile

    @include from('lg') {
      max-width: none;
    }
  }

  .learning__title-white {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    font-size: 2rem; // 32px mobile
    line-height: 0.9;

    @include from('lg') {
      font-size: 4rem; // 64px desktop
      letter-spacing: -0.03em;
    }
  }

  .learning__title-accent {
    font-size: 2.25rem; // 36px mobile
    line-height: 0.8;
    letter-spacing: -0.1875rem; // -3px

    @include from('lg') {
      font-size: 4.875rem; // 78px desktop
    }
  }

  .learning__subtitle {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 20.5rem; // 328px — narrower than 342px heading (Figma 2274:4437)
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    line-height: 1.2;
    color: var(--color-surface-200);

    @include from('lg') {
      max-width: 20.5rem; // 328px desktop
      text-align: right;
    }
  }

  .learning__subtitle-line {
    display: block;
  }

  .learning__cta {
    display: flex;
    justify-content: center;
    width: 100%;

    @include from('lg') {
      grid-column: 2;
      grid-row: 2;
      justify-content: flex-end;
      align-items: end;
      width: auto;
    }
  }

  // Figma 2274:5499 desktop 204×62 / 2274:4470 mobile 342×62.
  .learning__cta-btn {
    width: 100%;
    height: 3.875rem; // 62px
    min-height: 0;
    padding: 0;
    font-size: var(--fs-body-sm); // 14px Button Text
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: 0;

    &::before {
      background-color: var(--color-accent);
      background-image: url('/images/ui/btn-primary-shell-mobile.png');
      background-size: 100% 100%;
      background-position: center;
    }

    @include from('lg') {
      width: 12.75rem; // 204px

      &::before {
        background-image: url('/images/ui/btn-primary-shell-header.png');
      }
    }
  }
</style>
