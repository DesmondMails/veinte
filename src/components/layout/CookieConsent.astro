<aside
  class="cookie-consent"
  data-cookie-consent
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div class="cookie-consent__content">
    <h2 id="cookie-consent-title" class="cookie-consent__title">
      Ми використовуємо файли cookies <span class="cookie-consent__emoji" aria-hidden="true">🍪</span>
    </h2>
    <p id="cookie-consent-description" class="cookie-consent__description">
      Вони допомагають нам покращувати роботу сайту та аналізувати його використання.
    </p>
  </div>

  <div class="cookie-consent__actions">
    <div class="cookie-consent__buttons">
      <button class="cookie-consent__button cookie-consent__button--reject" type="button" data-cookie-reject>
        <span class="cookie-consent__button-shell" aria-hidden="true"></span>
        <span class="cookie-consent__button-label">Відхилити</span>
      </button>
      <button class="cookie-consent__button cookie-consent__button--accept" type="button" data-cookie-accept>
        <span class="cookie-consent__button-shell" aria-hidden="true"></span>
        <span class="cookie-consent__button-label">Прийняти всі</span>
      </button>
    </div>
    <a class="cookie-consent__details" href="/cookies">Детальніше</a>
  </div>
</aside>
